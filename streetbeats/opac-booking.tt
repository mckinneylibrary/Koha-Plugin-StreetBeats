[% INCLUDE 'opac-top.inc' %]
<div class="main">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div id="userstreetbeats" class="maincontent">
                    <h1>StreetBeats: Musician Booking</h1>

                    [% IF status == 'success' %]
                        <div class="alert alert-success">Booking confirmed! We look forward to your performance.</div>
                    [% ELSIF status == 'error' %]
                        <div class="alert alert-danger">Error: [% message %]</div>
                    [% END %]

                    [% IF logged_in_user %]
                        <div class="page-section">
                            <h3>Book a New Performance Slot</h3>
                            <form action="/cgi-bin/koha/opac-plugins.pl" method="post">
                                <input type="hidden" name="plugins_class" value="Koha::Plugin::Com::McKinney::StreetBeats"/>
                                <input type="hidden" name="plugins_method" value="opac"/>
                                <input type="hidden" name="action" value="book"/>

                                <div class="form-group">
                                    <label for="location_id">Select Location:</label>
                                    <select name="location_id" id="location_id" class="form-control" required>
                                        <option value="">-- Choose a Stage --</option>
                                        [% FOREACH loc IN locations %]
                                            <option value="[% loc.location_id %]">[% loc.location_name %]</option>
                                        [% END %]
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="start_time">Select Date & Time:</label>
                                    <input type="datetime-local" name="start_time" id="start_time" class="form-control" required />
                                </div>

                                <button type="submit" class="btn btn-primary">Confirm Booking</button>
                            </form>
                        </div>

                        <hr />

                        <div class="page-section">
                            <h3>Your Upcoming Performances</h3>
                            [% IF my_slots.size %]
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Date & Time</th>
                                            <th>Location</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH s IN my_slots %]
                                            <tr>
                                                <td>[% s.start_time %]</td>
                                                <td>[% s.location_name %]</td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            [% ELSE %]
                                <p>You don't have any bookings scheduled yet.</p>
                            [% END %]
                        </div>
                    [% ELSE %]
                        <div class="alert alert-info">
                            Please <a href="/cgi-bin/koha/opac-user.pl">log in with your Library Card</a> to book a performance slot.
                        </div>
                    [% END %]
                </div>
            </div>
        </div>
    </div>
</div>
[% INCLUDE 'opac-bottom.inc' %]
